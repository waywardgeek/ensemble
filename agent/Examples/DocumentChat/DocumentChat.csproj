<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><LangVersion>14</LangVersion>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Ensemble.csproj" />
    <Content Update="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../gui/wwwroot/vendor/bootstrap-5.3.8.min.css" Link="wwwroot/bootstrap.min.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../gui/wwwroot/vendor/bootstrap-LICENSE.txt" Link="wwwroot/BOOTSTRAP-LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../gui/wwwroot/artwork/paper-airplane-send.svg" Link="wwwroot/paper-airplane-send.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Ensemble.csproj" />
    <EmbeddedResource Include="wwwroot/**/*" LogicalName="EnsembleGui.Assets/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../skills/file-reading/SKILL.md" LogicalName="EnsembleGui.RendererSkill/file-reading" />
    <EmbeddedResource Include="../skills/code-tools/SKILL.md" LogicalName="EnsembleGui.RendererSkill/code-tools" />
    <!-- Explicit reviewed renderer set; discovering a skill does not execute its JavaScript. -->
    <EmbeddedResource Include="../skills/file-reading/renderers/list-directory.js" LogicalName="EnsembleGui.Assets/skills/file-reading/renderers/list-directory.js" />
    <EmbeddedResource Include="../skills/shared/terminal-output.js" LogicalName="EnsembleGui.Assets/skills/shared/terminal-output.js" />
    <EmbeddedResource Include="../skills/shared/command-output.js" LogicalName="EnsembleGui.Assets/skills/shared/command-output.js" />
    <EmbeddedResource Include="../skills/shared/tool-default.js" LogicalName="EnsembleGui.Assets/skills/shared/tool-default.js" />
    <EmbeddedResource Include="../skills/shared/markdown.js" LogicalName="EnsembleGui.Assets/skills/shared/markdown.js" />
    <EmbeddedResource Include="../skills/shared/markdown-parser.js" LogicalName="EnsembleGui.Assets/skills/shared/markdown-parser.js" />
    <EmbeddedResource Include="../skills/shared/source-code.js" LogicalName="EnsembleGui.Assets/skills/shared/source-code.js" />
    <EmbeddedResource Include="../skills/shared/file-excerpt.js" LogicalName="EnsembleGui.Assets/skills/shared/file-excerpt.js" />
    <EmbeddedResource Include="../skills/file-reading/renderers/read-file.js" LogicalName="EnsembleGui.Assets/skills/file-reading/renderers/read-file.js" />
    <EmbeddedResource Include="../skills/file-reading/renderers/search-files.js" LogicalName="EnsembleGui.Assets/skills/file-reading/renderers/search-files.js" />
    <EmbeddedResource Include="../skills/code-tools/renderers/write-file.js" LogicalName="EnsembleGui.Assets/skills/code-tools/renderers/write-file.js" />
    <EmbeddedResource Include="../skills/code-tools/renderers/edit-file.js" LogicalName="EnsembleGui.Assets/skills/code-tools/renderers/edit-file.js" />
  </ItemGroup>
</Project>

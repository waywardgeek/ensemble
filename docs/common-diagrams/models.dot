"Ensemble" -> "ModelAuthentication" [id="rel2", color="#164f86", fontcolor="#164f86", penwidth=3.0, arrowhead=normal, label="modelAuthentications", tooltip="Ensemble.modelAuthentications → ModelAuthentication; strong; many; reverse: ModelAuthentication.parent", constraint=true];

digraph Common {
graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.30, ranksep=1.1, overlap=false, splines=spline, outputorder=edgesfirst, fontname="Helvetica", fontsize=20, labelloc=t];
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=14, margin="0.16,0.10", color="#617384", penwidth=1.2];
edge [fontname="Helvetica", fontsize=10, arrowsize=1.25];
label="Models, configuration and authentication\nHeavy blue: cascade-delete   |   Thin orange: weak   |   Gray: stored data\nOpen triangle: one slot (may be null)   |   Filled triangle: many   |   Arrows: parent / holder → child / value";
"AgentObservation" [label="AgentObservation", fillcolor="#f3f5f6", tooltip="AgentObservation — agent/Common/Actor.cs:30"];

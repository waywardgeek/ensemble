"Mcp" [label="Mcp", fillcolor="#e3effb", tooltip="Mcp — agent/Common/Mcp.cs:103"];
"McpBrowser" [label="McpBrowser", fillcolor="#e3effb", tooltip="McpBrowser — agent/Common/McpBrowser.cs:9"];

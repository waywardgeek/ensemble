"Agent" -> "Agent" [id="rel16", color="#164f86", fontcolor="#164f86", penwidth=3.0, arrowhead=normal, label="children", tooltip="Agent.children → Agent; strong; many; reverse: Agent.agentParent; Child Agents are also owned by Ensemble; this is not a tree.", constraint=true];

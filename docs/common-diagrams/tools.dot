"McpToolDefinition" [label="McpToolDefinition", fillcolor="#f3f5f6", tooltip="McpToolDefinition — agent/Common/Mcp.cs:80"];
"McpWebSocketTransport" [label="McpWebSocketTransport\n(base: IMcpTransport)", fillcolor="#f3f5f6", tooltip="McpWebSocketTransport — agent/Common/Mcp.cs:60"];
"SearchEvidence" [label="SearchEvidence", fillcolor="#f3f5f6", tooltip="SearchEvidence — agent/Common/SearchEvidence.cs:14"];

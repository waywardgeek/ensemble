edge [fontname="Helvetica", fontsize=10, arrowsize=1.25];
label="Lifecycle ownership\nHeavy blue: cascade-delete   |   Thin orange: weak   |   Gray: stored data\nOpen triangle: one slot (may be null)   |   Filled triangle: many   |   Arrows: parent / holder → child / value";

digraph Print {
graph [rankdir=TB, pad=0.05, nodesep=0.12, ranksep=0.22, splines=spline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fillcolor="white", color="black", fontname="Helvetica", fontsize=20, margin="0.07,0.05"];
edge [arrowsize=1.1];
"Agent" [label="Agent"];
"CompressionLaunch" [label="Compression\nLaunch"];
"CompressionOutcome" [label="Compression\nOutcome"];
"Context" [label="Context"];
"Entry" [label="Entry"];
"Event" [label="Event"];
"History" [label="History"];
"HistorySnapshot" [label="History\nSnapshot"];
"MemoryEntry" [label="MemoryEntry"];
"MeterEntry" [label="MeterEntry"];
"Part" [label="Part"];
"PendingCompression" [label="Pending\nCompression"];
"Usage" [label="Usage"];
"UsageIdentity" [label="Usage\nIdentity"];
"Agent" -> "History" [penwidth=3, color="#164f86", arrowhead=onormal, constraint=true];
"Agent" -> "Agent" [penwidth=3, color="#164f86", arrowhead=normal, constraint=true];
"Agent" -> "Part" [penwidth=1, color="#687682", arrowhead=normal, constraint=true];
"Agent" -> "Part" [penwidth=1, color="#687682", arrowhead=normal, constraint=true];
"Agent" -> "Event" [penwidth=1, color="#687682", arrowhead=normal, constraint=true];
"CompressionOutcome" -> "MeterEntry" [penwidth=1, color="#687682", arrowhead=normal, constraint=true];
"Context" -> "Entry" [penwidth=1, color="#687682", arrowhead=normal, constraint=true];
"Context" -> "Part" [penwidth=1, color="#687682", arrowhead=normal, constraint=true];
"Context" -> "Usage" [penwidth=1, color="#687682", arrowhead=onormal, constraint=true];
"Context" -> "MemoryEntry" [penwidth=1, color="#687682", arrowhead=normal, constraint=true];
"Context" -> "PendingCompression" [penwidth=1, color="#687682", arrowhead=onormal, constraint=true];
"Context" -> "CompressionOutcome" [penwidth=1, color="#687682", arrowhead=onormal, constraint=true];
"Entry" -> "Part" [penwidth=1, color="#687682", arrowhead=normal, constraint=true];
"Event" -> "Part" [penwidth=1, color="#687682", arrowhead=normal, constraint=true];
"Event" -> "Usage" [penwidth=1, color="#687682", arrowhead=onormal, constraint=true];
"Event" -> "MemoryEntry" [penwidth=1, color="#687682", arrowhead=onormal, constraint=true];
"Event" -> "CompressionLaunch" [penwidth=1, color="#687682", arrowhead=onormal, constraint=true];
"Event" -> "CompressionOutcome" [penwidth=1, color="#687682", arrowhead=onormal, constraint=true];
"History" -> "Event" [penwidth=1, color="#687682", arrowhead=normal, constraint=true];
"History" -> "Context" [penwidth=1, color="#687682", arrowhead=onormal, constraint=true];
"HistorySnapshot" -> "Event" [penwidth=1, color="#687682", arrowhead=normal, constraint=true];
"HistorySnapshot" -> "Context" [penwidth=1, color="#687682", arrowhead=onormal, constraint=true];
"MeterEntry" -> "UsageIdentity" [penwidth=1, color="#687682", arrowhead=onormal, constraint=true];
"MeterEntry" -> "Usage" [penwidth=1, color="#687682", arrowhead=onormal, constraint=true];
"PendingCompression" -> "CompressionLaunch" [penwidth=1, color="#687682", arrowhead=onormal, constraint=true];
"PendingCompression" -> "Event" [penwidth=1, color="#687682", arrowhead=onormal, constraint=true];
"PendingCompression" -> "MemoryEntry" [penwidth=1, color="#687682", arrowhead=onormal, constraint=true];
}

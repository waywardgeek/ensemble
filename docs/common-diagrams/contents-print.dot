"TextPart" -> "Provenance" [penwidth=1, color="#687682", arrowhead=onormal, constraint=true];
"ToolCallPart" -> "Provenance" [penwidth=1, color="#687682", arrowhead=onormal, constraint=true];
"ToolResultPart" -> "Part" [penwidth=1, color="#687682", arrowhead=normal, constraint=true];
"ToolResultPart" -> "JobInfo" [penwidth=1, color="#687682", arrowhead=onormal, constraint=true];
"ToolResultPart" -> "WorkProductInfo" [penwidth=1, color="#687682", arrowhead=onormal, constraint=true];
"ToolResultPart" -> "DirectoryListing" [penwidth=1, color="#687682", arrowhead=onormal, constraint=true];
"ToolResultPart" -> "FileEvidence" [penwidth=1, color="#687682", arrowhead=onormal, constraint=true];
"ToolResultPart" -> "SearchEvidence" [penwidth=1, color="#687682", arrowhead=onormal, constraint=true];
"BlobPart" -> "Part" [style=dashed, color="#704090", arrowhead=empty, constraint=false];
"HandoffPart" -> "Part" [style=dashed, color="#704090", arrowhead=empty, constraint=false];
"OpaquePart" -> "Part" [style=dashed, color="#704090", arrowhead=empty, constraint=false];

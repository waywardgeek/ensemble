"TextPart" -> "Part" [style=dashed, color="#704090", arrowhead=empty, constraint=false];
"ToolCallPart" -> "Part" [style=dashed, color="#704090", arrowhead=empty, constraint=false];
"ToolResultPart" -> "Part" [style=dashed, color="#704090", arrowhead=empty, constraint=false];
}

// Independent probes derived from Edition 2 Chapter 6. Public names are adapters.
package ensemble_test

import (
	"bytes"
	"context"
	"encoding/json"
	ens "example.com/ensemble"
	"fmt"
	"io"
	"net/http"
	"net/http/httptest"
	"os"
	"path/filepath"
	"reflect"
	"strings"
	"sync"
	"testing"
	"time"
)

const c6Model = "fixture-ch06-independent"

type c6Observer func(ens.Observation)

func (f c6Observer) Observe(o ens.Observation) { f(o) }

type c6Call struct {
	body     []byte
	pieces   chan []byte
	canceled <-chan struct{}
}
type c6Fixture struct {
	t        *testing.T
	e        *ens.Ensemble
	a        *ens.Agent
	root     string
	requests chan c6Call
	plain    bool
	vendor   string
}

func c6Receive[T any](t *testing.T, ch <-chan T) T {
	t.Helper()
	select {
	case x := <-ch:
		return x
	case <-time.After(5 * time.Second):
		t.Fatal("independent barrier timed out")
		var zero T
		return zero
	}
}
func c6New(t *testing.T, e *ens.Ensemble, vendor string, plain bool, builtins ...string) *c6Fixture {
	t.Helper()
	f := &c6Fixture{t: t, e: e, root: t.TempDir(), requests: make(chan c6Call, 16), plain: plain, vendor: vendor}
	s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		body, _ := io.ReadAll(r.Body)
		call := c6Call{body, make(chan []byte, 16), r.Context().Done()}
		f.requests <- call
		if plain {
			w.Header().Set("Content-Type", "application/json")
		} else {
			w.Header().Set("Content-Type", "text/event-stream")
		}
		w.WriteHeader(200)
		w.(http.Flusher).Flush()
		for {
			select {
			case p, ok := <-call.pieces:
				if !ok {
					return
				}
				if _, err := w.Write(p); err != nil {
					return
				}
				w.(http.Flusher).Flush()
			case <-r.Context().Done():
				return
			}
		}
	}))
	var err error
	f.a, err = e.NewAgent(ens.Config{Vendor: vendor, Model: c6Model, ResolvedModel: c6Model, APIKey: "LOCAL", BaseURL: s.URL, Workspace: f.root, LogPath: filepath.Join(f.root, "events.log"), DisableStreaming: plain, Builtins: builtins})
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = f.a.Close(); s.Close() })
	return f
}
func c6Submit(t *testing.T, a *ens.Agent) ens.RequestHandle {
	t.Helper()
	h, err := a.Submit("exercise fixture")
	if err != nil {
		t.Fatal(err)
	}
	return h
}
func c6Wait(t *testing.T, h ens.RequestHandle) ens.Completion {
	t.Helper()
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	c, err := h.Wait(ctx)
	if err != nil {
		t.Fatal(err)
	}
	return c
}
func c6JSON(x any) []byte  { b, _ := json.Marshal(x); return b }
func c6Frame(x any) []byte { return append(append([]byte("data: "), c6JSON(x)...), []byte("\n\n")...) }
func c6Text(vendor, text string, plain bool) []byte {
	var x any
	switch vendor {
	case "anthropic":
		x = map[string]any{"model": c6Model, "content": []any{map[string]any{"type": "text", "text": text}}, "stop_reason": "end_turn", "usage": map[string]int{"input_tokens": 10, "output_tokens": 2}}
	case "openai":
		x = map[string]any{"model": c6Model, "choices": []any{map[string]any{"index": 0, "message": map[string]any{"role": "assistant", "content": text}, "finish_reason": "stop"}}, "usage": map[string]int{"prompt_tokens": 10, "completion_tokens": 2}}
	default:
		x = map[string]any{"modelVersion": c6Model, "candidates": []any{map[string]any{"index": 0, "content": map[string]any{"role": "model", "parts": []any{map[string]any{"text": text}}}, "finishReason": "STOP"}}, "usageMetadata": map[string]int{"promptTokenCount": 10, "candidatesTokenCount": 2}}
	}
	if plain {
		return c6JSON(x)
	}
	first, tail := c6TextStream(vendor, text)
	return append(first, tail...)
}
func c6TextStream(vendor, text string) ([]byte, []byte) {
	if vendor == "anthropic" {
		first := c6Frame(map[string]any{"type": "message_start", "message": map[string]any{"model": c6Model, "usage": map[string]int{"input_tokens": 10, "output_tokens": 0}}})
		first = append(first, c6Frame(map[string]any{"type": "content_block_start", "index": 0, "content_block": map[string]any{"type": "text", "text": text}})...)
		tail := c6Frame(map[string]any{"type": "content_block_stop", "index": 0})
		tail = append(tail, c6Frame(map[string]any{"type": "message_delta", "delta": map[string]string{"stop_reason": "end_turn"}, "usage": map[string]int{"output_tokens": 2}})...)
		return first, append(tail, c6Frame(map[string]any{"type": "message_stop"})...)
	}
	if vendor == "openai" {
		first := c6Frame(map[string]any{"model": c6Model, "choices": []any{map[string]any{"index": 0, "delta": map[string]string{"content": text}}}})
		tail := c6Frame(map[string]any{"model": c6Model, "choices": []any{map[string]any{"index": 0, "delta": map[string]any{}, "finish_reason": "stop"}}})
		tail = append(tail, c6Frame(map[string]any{"model": c6Model, "choices": []any{}, "usage": map[string]int{"prompt_tokens": 10, "completion_tokens": 2}})...)
		return first, append(tail, []byte("data: [DONE]\n\n")...)
	}
	return c6Frame(map[string]any{"modelVersion": c6Model, "candidates": []any{map[string]any{"index": 0, "content": map[string]any{"parts": []any{map[string]string{"text": text}}}}}}), c6Frame(map[string]any{"modelVersion": c6Model, "candidates": []any{map[string]any{"index": 0, "finishReason": "STOP"}}, "usageMetadata": map[string]int{"promptTokenCount": 10, "candidatesTokenCount": 2}})
}

type c6Tape struct {
	mu      sync.Mutex
	values  []ens.Observation
	changed chan struct{}
}

func c6Record(t *testing.T, f *c6Fixture) *c6Tape {
	t.Helper()
	out := &c6Tape{changed: make(chan struct{}, 1)}
	_, err := f.e.Subscribe(f.a.ID(), c6Observer(func(o ens.Observation) {
		out.mu.Lock()
		out.values = append(out.values, o)
		out.mu.Unlock()
		select {
		case out.changed <- struct{}{}:
		default:
		}
	}))
	if err != nil {
		t.Fatal(err)
	}
	return out
}
func (o *c6Tape) snapshot() []ens.Observation {
	o.mu.Lock()
	defer o.mu.Unlock()
	return append([]ens.Observation(nil), o.values...)
}
func (o *c6Tape) wait(t *testing.T, p func([]ens.Observation) bool) {
	t.Helper()
	deadline := time.After(5 * time.Second)
	for {
		if p(o.snapshot()) {
			return
		}
		select {
		case <-o.changed:
		case <-deadline:
			t.Fatal("public observation barrier timed out")
		}
	}
}
func c6ModelFacts(xs []ens.Observation) []ens.Observation {
	out := []ens.Observation{}
	for _, x := range xs {
		if x.OperationID != "" {
			out = append(out, x)
		}
	}
	return out
}
func TestC6PublicEarlyIdentity(t *testing.T) {
	for _, vendor := range []string{"anthropic", "openai", "gemini"} {
		t.Run(vendor, func(t *testing.T) {
			e := ens.New(io.Discard)
			defer e.Close()
			fs := []*c6Fixture{c6New(t, e, vendor, false), c6New(t, e, vendor, false)}
			tapes := []*c6Tape{c6Record(t, fs[0]), c6Record(t, fs[1])}
			previous := map[string]bool{}
			for round := 0; round < 2; round++ {
				hs := []ens.RequestHandle{c6Submit(t, fs[0].a), c6Submit(t, fs[1].a)}
				calls := []c6Call{c6Receive(t, fs[0].requests), c6Receive(t, fs[1].requests)}
				for i, f := range fs {
					first, _ := c6TextStream(vendor, "FIRST-VISIBLE")
					calls[i].pieces <- first
					tapes[i].wait(t, func(xs []ens.Observation) bool {
						for _, x := range xs {
							if x.RequestID == hs[i].ID() && x.Kind == "part_delta" && x.Text == "FIRST-VISIBLE" {
								return true
							}
						}
						return false
					})
					select {
					case <-hs[i].Done():
						t.Fatal("completed before provider terminal")
					default:
					}
					for _, x := range f.a.Events() {
						if x.Type == "response_ended" && round == 0 {
							t.Fatal("accepted provisional response")
						}
					}
				}
				for i := range fs {
					_, tail := c6TextStream(vendor, "FIRST-VISIBLE")
					calls[i].pieces <- tail
					close(calls[i].pieces)
					c := c6Wait(t, hs[i])
					if c.Outcome != "success" || c.Text != "FIRST-VISIBLE" {
						t.Fatalf("completion: %+v", c)
					}
					tapes[i].wait(t, func(xs []ens.Observation) bool {
						for _, x := range xs {
							if x.RequestID == hs[i].ID() && x.Kind == "model_end" {
								return true
							}
						}
						return false
					})
					facts := []ens.Observation{}
					for _, x := range c6ModelFacts(tapes[i].snapshot()) {
						if x.RequestID == hs[i].ID() {
							facts = append(facts, x)
						}
					}
					if len(facts) != 4 || facts[0].Kind != "model_begin" || facts[1].Kind != "part_delta" || facts[2].Kind != "part_final" || facts[3].Kind != "model_end" {
						t.Fatalf("operation order: %+v", facts)
					}
					op := facts[0].OperationID
					key := fs[i].a.ID() + "/" + op
					if op == "" || previous[key] {
						t.Fatal("operation identity reused within Agent")
					}
					previous[key] = true
					for _, x := range facts {
						if x.AgentID != fs[i].a.ID() || x.OperationID != op || x.RequestID != hs[i].ID() {
							t.Fatal("public full identity crossed operations")
						}
					}
					if facts[1].PartID <= 0 || facts[1].PartID != facts[2].PartID || facts[2].ResponseSeq != facts[3].ResponseSeq || !facts[3].Accepted {
						t.Fatal("part mapping differs")
					}
					found := false
					for _, event := range fs[i].a.Events() {
						if event.Seq == facts[2].ResponseSeq && event.Response != nil {
							found = ch10UnusedPartsEqual(event.Response.Parts[facts[2].PartIndex], *facts[2].Part)
							ch10FinalDiff(t, event.Response.Parts[facts[2].PartIndex], *facts[2].Part)
						}
					}
					if !found {
						t.Fatal("final does not map to persisted response")
					}
				}
			}
		})
	}
}

func TestC6PublicCancelProposedEffect(t *testing.T) {
	for _, action := range []string{"interrupt", "cancel", "close"} {
		t.Run(action, func(t *testing.T) {
			e := ens.New(io.Discard)
			defer e.Close()
			f := c6New(t, e, "gemini", false, "write_file")
			tape := c6Record(t, f)
			h := c6Submit(t, f.a)
			call := c6Receive(t, f.requests)
			proposal := c6Frame(map[string]any{"modelVersion": c6Model, "candidates": []any{map[string]any{"index": 0, "content": map[string]any{"parts": []any{map[string]any{"functionCall": map[string]any{"name": "write_file", "args": map[string]string{"path": "forbidden", "content": "no"}}}}}}}})
			call.pieces <- proposal
			tape.wait(t, func(xs []ens.Observation) bool {
				for _, x := range xs {
					if x.Kind == "part_delta" && x.Channel == "tool_args" {
						return true
					}
				}
				return false
			})
			var err error
			switch action {
			case "interrupt":
				_, err = f.a.Interrupt()
			case "cancel":
				err = h.Cancel()
			default:
				err = f.a.Close()
			}
			if err != nil {
				t.Fatal(err)
			}
			done := c6Wait(t, h)
			if done.Outcome == "success" {
				t.Fatal("incomplete operation succeeded")
			}
			c6Receive(t, call.canceled)
			tape.wait(t, func(xs []ens.Observation) bool {
				for _, x := range xs {
					if x.Kind == "model_end" {
						return true
					}
				}
				return false
			})
			for _, x := range c6ModelFacts(tape.snapshot()) {
				if x.Kind == "part_final" || x.Kind == "model_end" && x.Accepted {
					t.Fatal("interrupted proposal accepted")
				}
			}
			if _, err := os.Stat(filepath.Join(f.root, "forbidden")); !os.IsNotExist(err) {
				t.Fatal("proposal executed")
			}
			if f.a.Usage() != (ens.Usage{}) {
				t.Fatal("interrupted usage committed")
			}
			for _, event := range f.a.Events() {
				if event.Type == "response_ended" || event.Type == "tool_called" {
					t.Fatal("incomplete effect in durable history")
				}
			}
			if action != "close" {
				next := c6Submit(t, f.a)
				later := c6Receive(t, f.requests)
				later.pieces <- c6Text("gemini", "RECOVERED", false)
				close(later.pieces)
				if c := c6Wait(t, next); c.Text != "RECOVERED" || c.Outcome != "success" {
					t.Fatal("Agent did not recover")
				}
			}
		})
	}
}

func TestC6PublicObserverOverflow(t *testing.T) {
	e := ens.New(io.Discard)
	defer e.Close()
	f := c6New(t, e, "openai", false)
	fast := c6Record(t, f)
	entered := make(chan struct{})
	release := make(chan struct{})
	var once sync.Once
	id, err := e.Subscribe(f.a.ID(), c6Observer(func(o ens.Observation) { once.Do(func() { close(entered) }); <-release }))
	if err != nil {
		t.Fatal(err)
	}
	defer close(release)
	h := c6Submit(t, f.a)
	call := c6Receive(t, f.requests)
	c6Receive(t, entered)
	// One-frame-at-a-time acknowledgement keeps the fast subscriber positive
	// while the blocked subscriber's bounded queue fills deterministically.
	for i := 0; i < 300; i++ {
		piece := c6Frame(map[string]any{"model": c6Model, "choices": []any{map[string]any{"index": 0, "delta": map[string]string{"content": "x"}}}})
		call.pieces <- piece
		want := i + 1
		fast.wait(t, func(xs []ens.Observation) bool {
			n := 0
			for _, x := range xs {
				if x.Kind == "part_delta" {
					n += len(x.Text)
				}
			}
			return n == want
		})
	}
	if e.SubscriptionStatus(id) != "overflow" {
		t.Fatal("blocked observer did not report overflow")
	}
	_, tail := c6TextStream("openai", "")
	call.pieces <- tail
	close(call.pieces)
	done := c6Wait(t, h)
	if done.Outcome != "success" || done.Text != strings.Repeat("x", 300) {
		t.Fatal("observer consumed or blocked completion")
	}
	fast.wait(t, func(xs []ens.Observation) bool {
		for _, x := range xs {
			if x.Kind == "model_end" && x.Accepted {
				return true
			}
		}
		return false
	})
	if f.a.Usage().Output != 2 {
		t.Fatal("usage not committed once")
	}
}

func TestC6RecordedDeliveryReplay(t *testing.T) {
	for _, vendor := range []string{"anthropic", "openai", "gemini"} {
		for _, plain := range []bool{false, true} {
			t.Run(fmt.Sprint(vendor, plain), func(t *testing.T) {
				e := ens.New(io.Discard)
				defer e.Close()
				f := c6New(t, e, vendor, plain)
				h := c6Submit(t, f.a)
				call := c6Receive(t, f.requests)
				call.pieces <- c6Text(vendor, "REPLAY", plain)
				close(call.pieces)
				if c6Wait(t, h).Outcome != "success" {
					t.Fatal("positive request failed")
				}
				var seq uint64
				for _, x := range f.a.Events() {
					if x.Type == "request_sent" {
						seq = x.Seq
					}
				}
				config := f.a.Config()
				config.DisableStreaming = !plain
				if err := f.a.SetConfig(config); err != nil {
					t.Fatal(err)
				}
				got, err := f.a.ReconstructRequest(seq)
				if err != nil {
					t.Fatal(err)
				}
				if !bytes.Equal(got, call.body) {
					t.Fatalf("reconstruction ignored recorded delivery: %s != %s", got, call.body)
				}
				path := filepath.Join(f.root, "events.log")
				loaded, err := e.Load(path, config)
				if err != nil {
					t.Fatal(err)
				}
				defer loaded.Close()
				again, err := loaded.ReconstructRequest(seq)
				if err != nil || !bytes.Equal(got, again) {
					t.Fatal("load/replay changed delivery")
				}
				if plain {
					raw, err := os.ReadFile(path)
					if err != nil {
						t.Fatal(err)
					}
					raw = bytes.ReplaceAll(raw, []byte(`"delivery":"plain",`), nil)
					historical := filepath.Join(f.root, "historical.log")
					if err = os.WriteFile(historical, raw, 0600); err != nil {
						t.Fatal(err)
					}
					old, err := e.Load(historical, config)
					if err != nil {
						t.Fatal(err)
					}
					defer old.Close()
					got, err := old.ReconstructRequest(seq)
					if err != nil || !bytes.Equal(got, call.body) {
						t.Fatal("absent historical delivery no longer means plain")
					}
				}
				select {
				case <-f.requests:
					t.Fatal("replay performed HTTP")
				default:
				}
			})
		}
	}
}

func c6Complex(vendor string, plain bool) []byte {
	var body string
	if vendor == "anthropic" {
		if plain {
			body = `{"model":"_MODEL_","content":[{"type":"text","text":"VISIBLE"},{"type":"thinking","thinking":"Checking.","signature":"signed-value"},{"type":"tool_use","id":"read-a","name":"read_file","input":{"path":"notes.txt"}},{"type":"tool_use","id":"list-b","name":"list_directory","input":{"path":"."}}],"stop_reason":"tool_use","usage":{"input_tokens":10,"output_tokens":2}}`
		} else {
			body = `{"type":"message_start","message":{"model":"_MODEL_","usage":{"input_tokens":10,"output_tokens":0}}}
{"type":"content_block_start","index":0,"content_block":{"type":"text","text":"VIS"}}
{"type":"content_block_start","index":1,"content_block":{"type":"thinking","thinking":"Check","signature":""}}
{"type":"content_block_start","index":2,"content_block":{"type":"tool_use","id":"read-a","name":"read_file","input":{}}}
{"type":"content_block_start","index":3,"content_block":{"type":"tool_use","id":"list-b","name":"list_directory","input":{}}}
{"type":"content_block_delta","index":2,"delta":{"type":"input_json_delta","partial_json":"{\"path\":"}}
{"type":"content_block_delta","index":3,"delta":{"type":"input_json_delta","partial_json":"{\"path\":\""}}
{"type":"content_block_delta","index":1,"delta":{"type":"thinking_delta","thinking":"ing."}}
{"type":"content_block_delta","index":1,"delta":{"type":"signature_delta","signature":"signed-"}}
{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"IBLE"}}
{"type":"content_block_delta","index":3,"delta":{"type":"input_json_delta","partial_json":".\"}"}}
{"type":"content_block_delta","index":2,"delta":{"type":"input_json_delta","partial_json":"\"notes.txt\"}"}}
{"type":"content_block_delta","index":1,"delta":{"type":"signature_delta","signature":"value"}}
{"type":"content_block_stop","index":3}
{"type":"content_block_stop","index":0}
{"type":"content_block_stop","index":2}
{"type":"content_block_stop","index":1}
{"type":"message_delta","delta":{"stop_reason":"tool_use"},"usage":{"output_tokens":2}}
{"type":"message_stop"}`
		}
	} else if vendor == "openai" {
		if plain {
			body = `{"model":"_MODEL_","choices":[{"index":0,"message":{"role":"assistant","content":"VISIBLE","refusal":"preserved refusal","tool_calls":[{"id":"read-a","type":"function","function":{"name":"read_file","arguments":"{\"path\":\"notes.txt\"}"}},{"id":"list-b","type":"function","function":{"name":"list_directory","arguments":"{\"path\":\".\"}"}}]},"finish_reason":"tool_calls"}],"usage":{"prompt_tokens":10,"completion_tokens":2}}`
		} else {
			body = `{"model":"_MODEL_","choices":[{"index":1,"delta":{"content":"DISTRACTOR"}},{"index":0,"delta":{"tool_calls":[{"index":1,"id":"list-b","type":"function","function":{"name":"list_","arguments":"{\"path\":\""}}]}}]}
{"choices":[{"index":0,"delta":{"content":"VIS","tool_calls":[{"index":0,"id":"read-a","type":"function","function":{"name":"read_","arguments":"{\"path\":"}}]}}]}
{"choices":[{"index":0,"delta":{"refusal":"preserved ","tool_calls":[{"index":1,"function":{"name":"directory","arguments":".\"}"}}]}}]}
{"choices":[{"index":0,"delta":{"content":"IBLE","refusal":"refusal","tool_calls":[{"index":0,"function":{"name":"file","arguments":"\"notes.txt\"}"}}]},"finish_reason":"tool_calls"}]}
{"choices":[],"usage":{"prompt_tokens":10,"completion_tokens":2}}
[DONE]`
		}
	} else {
		parts := `[{"text":"VIS"},{"text":"IBLE","thought":false},{"text":"Check","thought":true},{"text":"ing.","thought":true},{"functionCall":{"id":"read-a","name":"read_file","args":{"path":"notes.txt"}},"thoughtSignature":"call-signature"},{"text":"","thoughtSignature":"empty-signature"},{"text":"hidden","future_payload":{"tag":"retain-me"}},{"functionCall":{"id":"list-b","name":"list_directory","args":{"path":"."}}}]`
		if plain {
			body = `{"modelVersion":"_MODEL_","candidates":[{"index":0,"content":{"parts":` + parts + `},"finishReason":"STOP"}],"usageMetadata":{"promptTokenCount":10,"candidatesTokenCount":2}}`
		} else {
			var values []json.RawMessage
			_ = json.Unmarshal([]byte(parts), &values)
			var out bytes.Buffer
			for _, p := range values {
				out.Write(c6Frame(map[string]any{"modelVersion": c6Model, "candidates": []any{map[string]any{"index": 0, "content": map[string]any{"parts": []json.RawMessage{p}}}}}))
			}
			out.Write(c6Frame(map[string]any{"candidates": []any{map[string]any{"index": 0, "finishReason": "STOP"}}, "usageMetadata": map[string]int{"promptTokenCount": 10, "candidatesTokenCount": 2}}))
			return out.Bytes()
		}
	}
	body = strings.ReplaceAll(body, "_MODEL_", c6Model)
	if plain {
		return []byte(body)
	}
	var out strings.Builder
	for _, line := range strings.Split(body, "\n") {
		out.WriteString("data: " + line + "\n\n")
	}
	return []byte(out.String())
}
func TestC6TypedCallsAndOpaque(t *testing.T) {
	for _, vendor := range []string{"anthropic", "openai", "gemini"} {
		t.Run(vendor, func(t *testing.T) {
			var responses []ens.Response
			for _, plain := range []bool{false, true} {
				e := ens.New(io.Discard)
				defer e.Close()
				f := c6New(t, e, vendor, plain, "read_file", "list_directory")
				if err := os.WriteFile(filepath.Join(f.root, "notes.txt"), []byte("ACTUAL-NOTES"), 0600); err != nil {
					t.Fatal(err)
				}
				tape := c6Record(t, f)
				h := c6Submit(t, f.a)
				call := c6Receive(t, f.requests)
				call.pieces <- c6Complex(vendor, plain)
				close(call.pieces)
				var continuation c6Call
				select {
				case continuation = <-f.requests:
				case <-h.Done():
					c := c6Wait(t, h)
					t.Fatalf("typed operation ended before continuation: %+v error=%+v", c, c.Error)
				case <-time.After(5 * time.Second):
					t.Fatal("typed continuation timed out")
				}
				if !bytes.Contains(continuation.body, []byte("ACTUAL-NOTES")) {
					t.Fatal("read_file result did not reach continuation")
				}
				if vendor == "openai" && !bytes.Contains(continuation.body, []byte(`"refusal":"preserved refusal"`)) {
					t.Fatal("recognized refusal missing from continuation")
				}
				continuation.pieces <- c6Text(vendor, "DONE", plain)
				close(continuation.pieces)
				done := c6Wait(t, h)
				if done.Outcome != "success" || done.Text != "DONE" {
					t.Fatalf("typed fixture failed: %+v", done)
				}
				var response ens.Response
				var seq uint64
				calls := []string{}
				returned := 0
				for _, event := range f.a.Events() {
					if event.Type == "response_ended" && seq == 0 {
						response = *event.Response
						seq = event.Seq
					}
					if event.Type == "tool_called" {
						calls = append(calls, event.Tool.Name)
					}
					if event.Type == "tool_returned" {
						returned++
					}
				}
				if !reflect.DeepEqual(calls, []string{"read_file", "list_directory"}) || returned != 2 {
					t.Fatalf("real interleaved call effects/order: %v/%d", calls, returned)
				}
				if response.Usage == nil || response.Usage.Output != 2 || f.a.Usage().Output != 4 {
					t.Fatal("typed accounting not once per response")
				}
				visible := ""
				callParts := []ens.Part{}
				opaque := 0
				for _, p := range response.Parts {
					if p.Text != nil && p.Type == "text" {
						visible += *p.Text
					}
					if p.Type == "tool_call" {
						callParts = append(callParts, p)
					}
					if p.Type == "opaque" {
						opaque++
					}
				}
				if visible != "VISIBLE" || len(callParts) != 2 || callParts[0].CallID != "read-a" || callParts[1].CallID != "list-b" || opaque == 0 {
					t.Fatalf("typed meaning changed: %s", c6JSON(response.Parts))
				}
				if vendor == "anthropic" {
					var thinking map[string]any
					if len(response.Parts) != 4 || json.Unmarshal(response.Parts[1].Data, &thinking) != nil || thinking["thinking"] != "Checking." || thinking["signature"] != "signed-value" {
						t.Fatal("thinking or signature retention changed")
					}
				}
				if vendor == "gemini" {
					if len(response.Parts) != 6 || string(callParts[0].Opaque) != `"call-signature"` || response.Parts[3].Text == nil || *response.Parts[3].Text != "" || string(response.Parts[3].Opaque) != `"empty-signature"` {
						t.Fatal("signed part retention changed")
					}
				}
				for i, want := range []string{"notes.txt", "."} {
					var args map[string]string
					if json.Unmarshal(callParts[i].Args, &args) != nil || args["path"] != want || len(args) != 1 {
						t.Fatal("interleaved arguments crossed identities")
					}
				}
				tape.wait(t, func(xs []ens.Observation) bool {
					ends := 0
					for _, x := range xs {
						if x.Kind == "model_end" {
							ends++
						}
					}
					return ends == 2
				})
				obs := c6ModelFacts(tape.snapshot())
				op := obs[0].OperationID
				grouped := map[int]map[string]string{}
				finals := []ens.Observation{}
				for _, x := range obs {
					if x.OperationID != op {
						continue
					}
					if x.Kind == "part_delta" {
						if plain {
							t.Fatal("plain typed response emitted delta")
						}
						if strings.Contains(x.Text, "signature") || strings.Contains(x.Text, "signed-value") || x.Text == "hidden" {
							t.Fatal("opaque material exposed as delta")
						}
						if grouped[x.PartID] == nil {
							grouped[x.PartID] = map[string]string{}
						}
						grouped[x.PartID][x.Channel] += x.Text
					}
					if x.Kind == "part_final" {
						finals = append(finals, x)
					}
				}
				if len(finals) != len(response.Parts) {
					t.Fatal("missing typed final")
				}
				seen := map[int]bool{}
				for i, x := range finals {
					ch10FinalDiff(t, *x.Part, response.Parts[i])
					if x.PartID <= 0 || seen[x.PartID] || x.PartIndex != i || x.ResponseSeq != seq || !ch10UnusedPartsEqual(*x.Part, response.Parts[i]) {
						t.Fatal("typed final mapping changed")
					}
					seen[x.PartID] = true
					if !plain && x.Part.Type == "tool_call" {
						g := grouped[x.PartID]
						if g["tool_name"] != x.Part.Name {
							t.Fatal("tool name fragments mapped to wrong part")
						}
						var got, want any
						if json.Unmarshal([]byte(g["tool_args"]), &got) != nil || json.Unmarshal(x.Part.Args, &want) != nil || !reflect.DeepEqual(got, want) {
							t.Fatal("argument fragments do not reconstruct this call")
						}
					}
				}
				if !plain && vendor != "openai" {
					thinking := ""
					for _, g := range grouped {
						thinking += g["thinking"]
					}
					if thinking != "Checking." {
						t.Fatal("thinking fragments missing or entered wrong part")
					}
				}
				responses = append(responses, response)
			}
			var left, right any
			_ = json.Unmarshal(c6JSON(responses[0]), &left)
			_ = json.Unmarshal(c6JSON(responses[1]), &right)
			if !reflect.DeepEqual(left, right) {
				t.Fatalf("plain/stream full typed response differs:\n%s\n%s", c6JSON(responses[0]), c6JSON(responses[1]))
			}
		})
	}
}

func c6GeminiCall(name string, args any, id string, terminal bool) []byte {
	call := map[string]any{"name": name, "args": args}
	if id != "" {
		call["id"] = id
	}
	candidate := map[string]any{"index": 0, "content": map[string]any{"parts": []any{map[string]any{"functionCall": call}}}}
	if terminal {
		candidate["finishReason"] = "STOP"
	}
	return c6Frame(map[string]any{"modelVersion": c6Model, "candidates": []any{candidate}, "usageMetadata": map[string]int{"promptTokenCount": 10, "candidatesTokenCount": 2}})
}
func TestC6JobSequenceInterleave(t *testing.T) {
	e := ens.New(io.Discard)
	defer e.Close()
	f := c6New(t, e, "gemini", false, "run_command", "read_file")
	tape := c6Record(t, f)
	if err := os.WriteFile(filepath.Join(f.root, "notes.txt"), []byte("SEQUENCE-NOTES"), 0600); err != nil {
		t.Fatal(err)
	}
	h := c6Submit(t, f.a)
	first := c6Receive(t, f.requests)
	first.pieces <- c6GeminiCall("run_command", map[string]any{"command": "while [ ! -f release-job ]; do sleep 0.02; done; printf JOB-DONE", "ai_callback_delay": 0}, "job-start", true)
	close(first.pieces)
	second := c6Receive(t, f.requests)
	if !bytes.Contains(second.body, []byte("running")) {
		t.Fatal("positive job did not outlive first tool report")
	}
	second.pieces <- c6GeminiCall("read_file", map[string]string{"path": "notes.txt"}, "", false)
	tape.wait(t, func(xs []ens.Observation) bool {
		for _, x := range xs {
			if x.Kind == "part_delta" && x.Channel == "tool_name" && x.Text == "read_file" {
				return true
			}
		}
		return false
	})
	if err := os.WriteFile(filepath.Join(f.root, "release-job"), []byte("release"), 0600); err != nil {
		t.Fatal(err)
	}
	tape.wait(t, func(xs []ens.Observation) bool {
		for _, x := range xs {
			if x.Kind == "job_ended" {
				return true
			}
		}
		return false
	})
	var ended uint64
	for _, event := range f.a.Events() {
		if event.Type == "job_ended" {
			ended = event.Seq
		}
	}
	second.pieces <- c6Frame(map[string]any{"candidates": []any{map[string]any{"index": 0, "finishReason": "STOP"}}, "usageMetadata": map[string]int{"promptTokenCount": 10, "candidatesTokenCount": 2}})
	close(second.pieces)
	third := c6Receive(t, f.requests)
	if !bytes.Contains(third.body, []byte("SEQUENCE-NOTES")) {
		t.Fatal("append-time call did not execute")
	}
	third.pieces <- c6Text("gemini", "DONE", false)
	close(third.pieces)
	if c6Wait(t, h).Outcome != "success" {
		t.Fatal("job sequence request failed")
	}
	var response ens.Event
	for _, event := range f.a.Events() {
		if event.Type == "response_ended" && event.Seq > ended {
			response = event
			break
		}
	}
	if response.Response == nil || ended == 0 || response.Seq <= ended {
		t.Fatal("job fact was held behind model response")
	}
	want := fmt.Sprintf("call-%d-0", response.Seq)
	if response.Response.Parts[0].CallID != want {
		t.Fatalf("call ID predicted before actual sequence: got %s want %s", response.Response.Parts[0].CallID, want)
	}
	tape.wait(t, func(xs []ens.Observation) bool {
		for _, x := range xs {
			if x.Kind == "part_final" && x.ResponseSeq == response.Seq {
				return true
			}
		}
		return false
	})
	for _, x := range tape.snapshot() {
		if x.Kind == "part_final" && x.ResponseSeq == response.Seq {
			if x.Part.CallID != want || x.PartIndex != 0 {
				t.Fatal("public final used predicted sequence")
			}
		}
	}
}

func c6Unknown(parts any, plain bool) []byte {
	x := map[string]any{"modelVersion": c6Model, "candidates": []any{map[string]any{"index": 0, "content": map[string]any{"parts": parts}, "finishReason": "STOP"}}, "usageMetadata": map[string]int{"promptTokenCount": 10, "candidatesTokenCount": 2}}
	if plain {
		return c6JSON(x)
	}
	return c6Frame(x)
}
func TestC6UnknownTextReplay(t *testing.T) {
	for _, plain := range []bool{false, true} {
		t.Run(fmt.Sprint(plain), func(t *testing.T) {
			e := ens.New(io.Discard)
			defer e.Close()
			f := c6New(t, e, "gemini", plain)
			tape := c6Record(t, f)
			h := c6Submit(t, f.a)
			call := c6Receive(t, f.requests)
			call.pieces <- c6Unknown([]any{map[string]string{"text": "A"}, map[string]any{"text": "hidden", "future_payload": map[string]string{"tag": "retain-me"}}, map[string]string{"text": "B"}}, plain)
			close(call.pieces)
			c := c6Wait(t, h)
			if c.Outcome != "success" || c.Text != "AB" || len(c.Parts) != 3 || c.Parts[1].Type != "opaque" {
				t.Fatal("unknown text classification changed")
			}
			tape.wait(t, func(xs []ens.Observation) bool {
				for _, x := range xs {
					if x.Kind == "model_end" {
						return true
					}
				}
				return false
			})
			for _, x := range tape.snapshot() {
				if x.Kind == "part_delta" && strings.Contains(x.Text, "hidden") {
					t.Fatal("unknown text emitted a provisional delta")
				}
			}
			next := c6Submit(t, f.a)
			matching := c6Receive(t, f.requests)
			if !bytes.Contains(matching.body, []byte("retain-me")) || !bytes.Contains(matching.body, []byte("hidden")) {
				t.Fatal("matching render lost whole opaque object")
			}
			matching.pieces <- c6Text("gemini", "NEXT", plain)
			close(matching.pieces)
			if c6Wait(t, next).Outcome != "success" {
				t.Fatal("matching continuation failed")
			}
			config := f.a.Config()
			config.Vendor = "openai"
			if err := f.a.SetConfig(config); err != nil {
				t.Fatal(err)
			}
			foreign := c6Submit(t, f.a)
			wire := c6Receive(t, f.requests)
			if bytes.Contains(wire.body, []byte("hidden")) || bytes.Contains(wire.body, []byte("retain-me")) {
				t.Fatal("foreign render kept standalone opaque material")
			}
			wire.pieces <- c6Text("openai", "FOREIGN", plain)
			close(wire.pieces)
			if c6Wait(t, foreign).Outcome != "success" {
				t.Fatal("foreign rendering failed")
			}
		})
	}
	for _, bad := range []any{[]any{map[string]any{"text": "hidden", "future": true}}, []any{map[string]any{"text": 5, "future": true}, map[string]string{"text": "visible"}}, []any{map[string]any{"text": "hidden", "thought": "wrong", "future": true}, map[string]string{"text": "visible"}}, []any{map[string]any{"text": "hidden", "thoughtSignature": 4, "future": true}, map[string]string{"text": "visible"}}} {
		for _, plain := range []bool{false, true} {
			e := ens.New(io.Discard)
			f := c6New(t, e, "gemini", plain)
			h := c6Submit(t, f.a)
			wire := c6Receive(t, f.requests)
			wire.pieces <- c6Unknown(bad, plain)
			close(wire.pieces)
			c := c6Wait(t, h)
			if c.Outcome != "error" || f.a.Usage() != (ens.Usage{}) {
				t.Fatal("opaque classification concealed invalid/absent answer")
			}
			_ = e.Close()
		}
	}
}

// Diagnostic only: original equality assertions above remain unchanged.
func ch10FinalDiff(t *testing.T, left, right any) {
	a, _ := json.Marshal(left)
	b, _ := json.Marshal(right)
	t.Logf("mapping diagnostic identical public JSON=%v left=%s right=%s", string(a) == string(b), a, b)
	var walk func(string, reflect.Value, reflect.Value)
	walk = func(path string, a, b reflect.Value) {
		if !a.IsValid() || !b.IsValid() {
			if a.IsValid() != b.IsValid() {
				t.Logf("difference %s validity", path)
			}
			return
		}
		if a.Type() != b.Type() {
			t.Logf("difference %s type %v / %v", path, a.Type(), b.Type())
			return
		}
		if reflect.DeepEqual(a.Interface(), b.Interface()) {
			return
		}
		switch a.Kind() {
		case reflect.Pointer, reflect.Interface:
			if a.IsNil() || b.IsNil() {
				t.Logf("difference %s nil %v / %v", path, a.IsNil(), b.IsNil())
				return
			}
			walk(path+"*", a.Elem(), b.Elem())
		case reflect.Struct:
			for i := 0; i < a.NumField(); i++ {
				walk(path+"."+a.Type().Field(i).Name, a.Field(i), b.Field(i))
			}
		case reflect.Slice:
			if a.IsNil() != b.IsNil() || a.Len() != b.Len() {
				t.Logf("difference %s nil=%v/%v length=%d/%d", path, a.IsNil(), b.IsNil(), a.Len(), b.Len())
			}
			for i := 0; i < a.Len() && i < b.Len(); i++ {
				walk(path+"[]", a.Index(i), b.Index(i))
			}
		default:
			t.Logf("difference %s value %v / %v", path, a.Interface(), b.Interface())
		}
	}
	walk("Part", reflect.ValueOf(left), reflect.ValueOf(right))
}

// This experiment changes only an unused omitted collection representation.
// It is not an accepted oracle adapter; material content remains exact.
func ch10UnusedPartsEqual(a, b ens.Part) bool {
	if a.Type != "tool_result" && len(a.Parts) == 0 {
		a.Parts = nil
	}
	if b.Type != "tool_result" && len(b.Parts) == 0 {
		b.Parts = nil
	}
	return reflect.DeepEqual(a, b)
}

<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pinned third-party source; keep its original language/nullability conventions.
       net10 supplies the Span/Buffer/ValueTuple APIs formerly obtained as packages. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.2</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Ensemble.Noise</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="libsodium" Version="[1.0.22]" />
  </ItemGroup>
</Project>

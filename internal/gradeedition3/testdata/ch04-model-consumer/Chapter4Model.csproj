<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup>
    <AgentEntryPoint Condition="'$(AgentEntryPoint)' == ''">Send</AgentEntryPoint>
    <DefineConstants Condition="'$(AgentEntryPoint)' == 'Ask'">$(DefineConstants);EARLY_AGENT_ASK</DefineConstants>
  </PropertyGroup>
  <Target Name="ValidateEntryPoint" BeforeTargets="CoreCompile">
    <Error Condition="'$(AgentEntryPoint)' != 'Ask' And '$(AgentEntryPoint)' != 'Send'"
           Text="AgentEntryPoint must be Ask (early chapter) or Send (current runtime)." />
  </Target>
  <ItemGroup><FrameworkReference Include="Microsoft.AspNetCore.App" /></ItemGroup>
  <Target Name="RequireCandidate" BeforeTargets="ResolveReferences">
    <Error Condition="'$(CandidateAssembly)' == '' Or !Exists('$(CandidateAssembly)')"
           Text="Supply CandidateAssembly as the absolute path to the candidate Ensemble.dll." />
  </Target>
  <ItemGroup>
    <Reference Include="Ensemble"><HintPath>$(CandidateAssembly)</HintPath></Reference>
  </ItemGroup>
</Project>

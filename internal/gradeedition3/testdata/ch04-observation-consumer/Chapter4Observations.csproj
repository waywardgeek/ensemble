<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <Target Name="RequireCandidate" BeforeTargets="ResolveReferences">
    <Error Condition="'$(CandidateAssembly)' == '' Or !Exists('$(CandidateAssembly)')"
           Text="Supply CandidateAssembly as the absolute path to the candidate Ensemble.dll." />
  </Target>
  <ItemGroup>
    <Reference Include="Ensemble"><HintPath>$(CandidateAssembly)</HintPath></Reference>
  </ItemGroup>
</Project>

r.\",\"name\":\"edit_file\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"old_text\":{\"type\":\"string\"},\"new_text\":{\"type\":\"string\"}},\"required\":[\"path\",\"old_text\",\"new_text\"]}},{\"description\":\"Start a fresh /bin/sh in a PTY. cwd applies only to this call, relative to the workspace. Merged output and exit_code stay on disk; a running report is a handle, not cancellation. ai_callback_delay is seconds (default 3); pattern matches unseen output; max_output_bytes defaults to 16384.\",\"name\":\"run_command\",\"parameters\":{\"type\":\"object\",\"properties\":{\"command\":{\"type\":\"string\"},\"cwd\":{\"type\":\"string\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"command\"]}},{\"description\":\"Wait for a job, including a finished job. Return only unseen output; waiting does not stop execution.\",\"name\":\"wait_for_job\",\"parameters\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"integer\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"handle\"]}},{\"description\":\"Send a line of input to a running PTY job, then wait. A missing trailing newline is added.\",\"name\":\"send_input\",\"parameters\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"integer\"},\"input\":{\"type\":\"string\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"handle\",\"input\"]}},{\"description\":\"Kill a job's process group. Go-only work is marked killed but its goroutine cannot be stopped.\",\"name\":\"kill_job\",\"parameters\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"integer\"}},\"required\":[\"handle\"]}},{\"description\":\"Set one-shot wait/output limits for the very next call, whichever tool it is. That call reports consumption; explicit call arguments override these limits.\",\"name\":\"tool_limits\",\"parameters\":{\"type\":\"object\",\"properties\":{\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[]}}]}]}","event":"request"}

pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"content\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Answer a question sent by one of your children. Omit message_id only when that child has one pending question.\",\"name\":\"respond_to_parent_message\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"message_id\":{\"type\":\"string\"},\"response\":{\"type\":\"string\"}},\"required\":[\"agent_id\",\"response\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Finish your task with a result. Rejected while children remain unfinished: join them or shut them down first.\",\"name\":\"submit\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"result\":{\"type\":\"string\"}},\"required\":[\"result\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Load an available skill and its dependencies. Appends its instructions to context and enables its tools.\",\"name\":\"load_skill\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"}},\"required\":[\"name\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Mark a loaded skill for removal at the next compaction. Its tools stop now; instructions remain until then.\",\"name\":\"unload_skill\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"}},\"required\":[\"name\"]},\"strict\":false}]}],\"top_logprobs\":0,\"top_p\":0.98,\"truncation\":\"disabled\",\"usage\":{\"attribution\":{\"items\":{\"msg_06051b785ddf3beb016acbdea520ec87d09c72ec18ec15fccf\":{\"cache_write_tokens\":0,\"cached_tokens\":0,\"content\":[{\"cache_write_tokens\":0,\"cached_tokens\":0,\"input_tokens\":76,\"output_tokens\":0}],\"input_tokens\":76,\"output_tokens\":0},\"msg_06051b7
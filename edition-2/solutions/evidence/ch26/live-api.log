eparate question to an owned child and wait for that turn's result.\",\"name\":\"ask_agent\",\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"},\"cursor\":{\"type\":\"integer\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"agent_id\",\"content\"]},\"strict\":false,\"type\":\"function\"},{\"description\":\"Read an owned child's submitted result, with durable submit.md fallback.\",\"name\":\"get_submission\",\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"agent_id\"]},\"strict\":false,\"type\":\"function\"},{\"description\":\"Cancel and remove an owned child immediately, including its jobs and descendants; retain saved results.\",\"name\":\"kill_agent\",\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"agent_id\"]},\"strict\":false,\"type\":\"function\"},{\"description\":\"Report an owned child's lifecycle, activity and measured session token usage.\",\"name\":\"get_sub_agent_status\",\
cription\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"agent_id\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Queue a separate question to an owned child and wait for that turn's result.\",\"name\":\"ask_agent\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"},\"cursor\":{\"type\":\"integer\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"agent_id\",\"content\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Read an owned child's submitted result, with durable submit.md fallback.\",\"name\":\"get_submission\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"agent_id\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Cancel and remove an owned child immediately, including its jobs and descendants; retain saved results.\",\"name\":\"kill_agent\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"agent_id\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Report an owned child's lifecycle, activity and measured session token usage.\",\"name\":\"get_sub_agent_status\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"agent_id\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"End an owned child's turn while keeping the Agent and other jobs alive. mode now cancels the request; after_tool waits for the next tool report.\",\"name\":\"interrupt_agent\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"mode\":{\"type\":\"string\",\"enum\":[\"now\",\"after_tool\"]},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"agent_id\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Start a full child agent with an isolated data directory. It inherits your model and restrictions; optional model selects another supported model. Children must submit results.\",\"name\":\"spawn_sub_agent\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"task\":{\"type\":\"string\"},\"model\":{\"type\":\"string\"}},\"required\":[\"agent_id\",\"task\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Wait for the listed children to submit; an empty list means all children. Returns early with pending questions: answer using respond_to_parent_message, then join again. A running job report is not completion.\",\"name\":\"join_agents\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_ids\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[]},\"strict\":false},{\"type\":\"function\",\"description\":\"List only your owned children and their explicit submission or failure state.\",\"name\":\"agents_status\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{}},\"strict\":false},{\"type\":\"function\",\"description\":\"Stop and remove one owned child recursively. Its saved conversation remains for a later spawn with the same ID.\",\"name\":\"shutdown_agent\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"}},\"required\":[\"agent_id\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Ask your parent (or the human for a root agent) a question and wait for a reply. This does not submit your work. If backgrounded, wait_for_job retrieves the reply.\",\"name\":\"send_message_to_parent\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"content\":{\"type\":\"string\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"content\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Answer a question sent by one of your children. Omit message_id only when that child has one pending question.\",\"name\":\"respond_to_parent_message\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"message_id\":{\"type\":\"string\"},\"response\":{\"type\":\"string\"}},\"required\":[\"agent_id\",\"response\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Finish your task with a result. Rejected while children remain unfinished: join them or shut them down first.\",\"name\":\"submit\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"result\":{\"type\":\"string\"}},\"required\":[\"result\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Load an available skill and its dependencies. Appends its instructions to context and enables its tools.\",\"name\":\"load_skill\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"}},\"required\":[\"name\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Mark a loaded skill for removal at the next compaction. Its tools stop now; instructions remain until then.\",\"name\":\"unload_skill\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"}},\"required\":[\"name\"]},\"strict\":false}]}],\"top_logprobs\":0,\"top_p\":0.98,\"truncation\":\"disabled\",\"usage\":null,\"user\":null,\"metadata\":{}},\"sequence_number\":1}","event":"response.in_progress"}

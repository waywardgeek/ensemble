",\"response\"]},\"strict\":false,\"type\":\"function\"},{\"description\":\"Finish your task with a result. Rejected while children remain unfinished: join them or shut them down first.\",\"name\":\"submit\",\"parameters\":{\"type\":\"object\",\"properties\":{\"result\":{\"type\":\"string\"}},\"required\":[\"result\"]},\"strict\":false,\"type\":\"function\"},{\"description\":\"Load an available skill and its dependencies. Appends its instructions to context and enables its tools.\",\"name\":\"load_skill\",\"parameters\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"}},\"required\":[\"name\"]},\"strict\":false,\"type\":\"function\"},{\"description\":\"Mark a loaded skill for removal at the next compaction. Its tools stop now; instructions remain until then.\",\"name\":\"unload_skill\",\"parameters\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"}},\"required\":[\"name\"]},\"strict\":false,\"type\":\"function\"}],\"type\":\"namespace\"}]}","event":"request"}

tring\"},\"start_line\":{\"type\":\"integer\"},\"end_line\":{\"type\":\"integer\"},\"max_bytes\":{\"type\":\"integer\"}},\"required\":[\"path\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"List immediate entries, sorted by name; directories end with /.\",\"name\":\"list_directory\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Search files recursively using a regular expression. context_lines defaults to zero. Output uses grep path:line:text and path-line-context with merged windows.\",\"name\":\"search_files\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"pattern\":{\"type\":\"string\"},\"context_lines\":{\"type\":\"integer\"}},\"required\":[\"path\",\"pattern\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Write text, creating parent directories. Existing files require overwrite:true unless append:true. Append preserves existing content.\",\"name\":\"write_file\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"},\"overwrite\":{\"type\":\"boolean\"},\"append\":{\"type\":\"boolean\"}},\"required\":[\"path\",\"content\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Replace one exact, unique old_text anchor with new_text. Zero or multiple matches refuse without changing the file; read and provide a more specific anchor.\",\"name\":\"edit_file\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"old_text\":{\"type\":\"string\"},\"new_text\":{\"type\":\"string\"}},\"required\":[\"path\",\"old_text\",\"new_text\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Start a fresh /bin/sh in a PTY. cwd applies only to this call, relative to the workspace. Merged output and exit_code stay on disk; a running report is a handle, not cancellation. ai_callback_delay is seconds (default 3); pattern matches unseen output; max_output_bytes defaults to 16384.\",\"name\":\"run_command\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"command\":{\"type\":\"string\"},\"cwd\":{\"type\":\"string\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"command\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Wait for a job, including a finished job. Return only unseen output; waiting does not stop execution.\",\"name\":\"wait_for_job\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"integer\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"handle\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Checkpoint at a completed micro-goal. Write text with what succeeded, what failed, source locations and next steps. Removes all tool traffic but preserves conversation and this note.\",\"name\":\"micro_handoff\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Keep the previous batch of tool results instead of automatic stubbing on supported models. Does not keep results of tools called alongside this call.\",\"name\":\"keep_tool_results\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{}},\"strict\":false},{\"type\":\"function\",\"description\":\"Wait for owned children to change, exit, ask a question, match output pattern, or stop progressing. Empty agent_ids means all children.\",\"name\":\"wait_for_agent_change\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_ids\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"pattern\":{\"type\":\"string\"},\"timeout_seconds\":{\"type\":\"number\"},\"stuck_seconds\":{\"type\":\"number\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[]},\"strict\":false},{\"type\":\"function\",\"description\":\"Send live steering to an owned child (hint when busy, new turn when idle). Return finalized output since cursor.\",\"name\":\"send_message\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"},\"cursor\":{\"type\":\"integer\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"agent_id\",\"content\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Wait for new finalized child output after cursor, or return when idle. Cursor is local to this child.\",\"name\":\"wait_for_agent\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"cursor\":{\"type\":\"integer\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"agent_id\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Queue a separate question to an owned child and wait for that turn's result.\",\"name\":\"ask_agent\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"},\"cursor\":{\"type\":\"integer\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"agent_id\",\"content\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Read an owned child's submitted result, with durable submit.md fallback.\",\"name\":\"get_submission\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"agent_id\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Cancel and remove an owned child immediately, including its jobs and descendants; retain saved results.\",\"name\":\"kill_agent\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"agent_id\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Report an owned child's lifecycle, activity and measured session token usage.\",\"name\":\"get_sub_agent_status\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"agent_id\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"End an owned child's turn while keeping the Agent and other jobs alive. mode now cancels the request; after_tool waits for the next tool report.\",\"name\":\"interrupt_agent\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"mode\":{\"type\":\"string\",\"enum\":[\"now\",\"after_tool\"]},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"agent_id\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Start a full child agent with an isolated data directory. It inherits your model and restrictions; optional model selects another supported model. Children must submit results.\",\"name\":\"spawn_sub_agent\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"task\":{\"type\":\"string\"},\"model\":{\"type\":\"string\"}},\"required\":[\"agent_id\",\"task\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Wait for the listed children to submit; an empty list means all children. Returns early with pending questions: answer using respond_to_parent_message, then join again. A running job report is not completion.\",\"name\":\"join_agents\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_ids\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[]},\"strict\":false},{\"type\":\"function\",\"description\":\"List only your owned children and their explicit submission or failure state.\",\"name\":\"agents_status\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{}},\"strict\":false},{\"type\":\"function\",\"description\":\"Stop and remove one owned child recursively. Its saved conversation remains for a later spawn with the same ID.\",\"name\":\"shutdown_agent\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"}},\"required\":[\"agent_id\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Ask your parent (or the human for a root agent) a question and wait for a reply. This does not submit your work. If backgrounded, wait_for_job retrieves the reply.\",\"name\":\"send_message_to_parent\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"content\":{\"type\":\"string\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"content\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Answer a question sent by one of your children. Omit message_id only when that child has one pending question.\",\"name\":\"respond_to_parent_message\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"message_id\":{\"type\":\"string\"},\"response\":{\"type\":\"string\"}},\"required\":[\"agent_id\",\"response\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Finish your task with a result. Rejected while children remain unfinished: join them or shut them down first.\",\"name\":\"submit\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"result\":{\"type\":\"string\"}},\"required\":[\"result\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Load an available skill and its dependencies. Appends its instructions to context and enables its tools.\",\"name\":\"load_skill\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"}},\"required\":[\"name\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Mark a loaded skill for removal at the next compaction. Its tools stop now; instructions remain until then.\",\"name\":\"unload_skill\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"}},\"required\":[\"name\"]},\"strict\":false}]}],\"top_logprobs\":0,\"top_p\":0.98,\"truncation\":\"disabled\",\"usage\":{\"attribution\":{\"items\":{\"msg_06183141c8d34df4016acbde97b52c87d0bd760ad4e70719cb\":{\"cache_write_tokens\":0,\"cached_tokens\":0,\"content\":[{\"cache_write_tokens\":0,\"cached_tokens\":0,\"input_tokens\":76,\"output_tokens\":0}],\"input_tokens\":76,\"output_tokens\":0},\"msg_0618314
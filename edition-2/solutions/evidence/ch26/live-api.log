ing again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"agent_id\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Report an owned child's lifecycle, activity and measured session token usage.\",\"name\":\"get_sub_agent_status\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"agent_id\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"End an owned child's turn while keeping the Agent and other jobs alive. mode now cancels the request; after_tool waits for the next tool report.\",\"name\":\"interrupt_agent\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"agent_id\":{\"type\":\"string\"},\"mode\":{\"type\":\"string\",\"enum\":[\"now\",\"after_tool\"]},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"agent_id\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Start a full child agent with an isolated data directory. It inherits your model and restrictions; optional model selects another supported model. Children must submit results.\",\"name\":\"spawn_sub_agent\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"ag
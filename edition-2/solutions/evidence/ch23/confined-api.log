tring\"},\"start_line\":{\"type\":\"integer\"},\"end_line\":{\"type\":\"integer\"},\"max_bytes\":{\"type\":\"integer\"}},\"required\":[\"path\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"List immediate entries, sorted by name; directories end with /.\",\"name\":\"list_directory\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Search files recursively using a regular expression. context_lines defaults to zero. Output uses grep path:line:text and path-line-context with merged windows.\",\"name\":\"search_files\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"pattern\":{\"type\":\"string\"},\"context_lines\":{\"type\":\"integer\"}},\"required\":[\"path\",\"pattern\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Write text, creating parent directories. Existing files require overwrite:true unless append:true. Append preserves existing content.\",\"name\":\"write_file\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"},\"overwrite\":{\"type\":\"boolean\"},\"append\":{\"type\":\"boolean\"}},\"required\":[\"path\",\"content\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Replace one exact, unique old_text anchor with new_text. Zero or multiple matches refuse without changing the file; read and provide a more specific anchor.\",\"name\":\"edit_file\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"old_text\":{\"type\":\"string\"},\"new_text\":{\"type\":\"string\"}},\"required\":[\"path\",\"old_text\",\"new_text\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Start a fresh /bin/sh in a PTY. cwd applies only to this call, relative to the workspace. Merged output and exit_code stay on disk; a running report is a handle, not cancellation. ai_callback_delay is seconds (default 3); pattern matches unseen output; max_output_bytes defaults to 16384.\",\"name\":\"run_command\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"command\":{\"type\":\"string\"},\"cwd\":{\"type\":\"string\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"command\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Wait for a job, including a finished job. Return only unseen output; waiting does not stop execution.\",\"name\":\"wait_for_job\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"integer\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"handle\"]},\"strict\":false},{\"type\":\"function\",\"description\":\"Send a line of input to a running PTY job, then wait. A missing trailing newline is added.\",\"name\":\"send_input\",\"output_schema\":null,\"parameters\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"integer\"},\"input\":{\"type\":\"string\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"handle\",\"i
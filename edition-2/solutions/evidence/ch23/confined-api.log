equired\":[\"path\",\"content\"]},\"strict\":false,\"type\":\"function\"},{\"description\":\"Replace one exact, unique old_text anchor with new_text. Zero or multiple matches refuse without changing the file; read and provide a more specific anchor.\",\"name\":\"edit_file\",\"parameters\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"},\"old_text\":{\"type\":\"string\"},\"new_text\":{\"type\":\"string\"}},\"required\":[\"path\",\"old_text\",\"new_text\"]},\"strict\":false,\"type\":\"function\"},{\"description\":\"Start a fresh /bin/sh in a PTY. cwd applies only to this call, relative to the workspace. Merged output and exit_code stay on disk; a running report is a handle, not cancellation. ai_callback_delay is seconds (default 3); pattern matches unseen output; max_output_bytes defaults to 16384.\",\"name\":\"run_command\",\"parameters\":{\"type\":\"object\",\"properties\":{\"command\":{\"type\":\"string\"},\"cwd\":{\"type\":\"string\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"command\"]},\"strict\":false,\"type\":\"function\"},{\"description\":\"Wait for a job, including a finished job. Return only unseen output; waiting does not stop execution.\",\"name\":\"wait_for_job\",\"parameters\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"integer\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"handle\"]},\"strict\":false,\"type\":\"function\"},{\"description\":\"Send a line of input to a running PTY job, then wait. A missing trailing newline is added.\",\"name\":\"send_input\",\"parameters\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"integer\"},\"input\":{\"type\":\"string\"},\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[\"handle\",\"input\"]},\"strict\":false,\"type\":\"function\"},{\"description\":\"Kill a job's process group. Go-only work is marked killed but its goroutine cannot be stopped.\",\"name\":\"kill_job\",\"parameters\":{\"type\":\"object\",\"properties\":{\"handle\":{\"type\":\"integer\"}},\"required\":[\"handle\"]},\"strict\":false,\"type\":\"function\"},{\"description\":\"Set one-shot wait/output limits for the very next call, whichever tool it is. That call reports consumption; explicit call arguments override these limits.\",\"name\":\"tool_limits\",\"parameters\":{\"type\":\"object\",\"properties\":{\"ai_callback_delay\":{\"type\":\"number\",\"description\":\"Seconds before looking again, default 3; never a job deadline\"},\"ai_callback_pattern\":{\"type\":\"string\",\"description\":\"Regex on unseen output\"},\"max_output_bytes\":{\"type\":\"integer\",\"description\":\"Inline output byte cap, default 16384\"}},\"required\":[]},\"strict\":false,\"type\":\"function\"},{\"description\":\"Checkpoint at a completed micro-goal. Write text with what succeeded, what failed, source locations and next steps. Removes all tool traffic but preserves conversation and this note.\",\"name\":\"micro_handoff\",\"parameters\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]},\"strict\":false,\"type\":\"function\"},{\"description\":\"Keep the previous batch of tool results instead of automatic stubbing on supported models. Does not keep results of tools called alongside this call.\",\"name\":\"keep_tool_results\",\"parameters\":{\"type\":\"object\",\"properties\":{}},\"strict\":false,\"type\":\"function\"}],\"type\":\"namespace\"}]}","event":"request"}
